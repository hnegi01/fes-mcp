# fes_mcp configuration reference.
# Copy to .env for local development (.env is gitignored; loaded by both
# `fes-mcp` and `fes-auth`). In hosted deployments, set these as real
# environment variables on the containers instead — no .env file there.

# ---------------------------------------------------------------------------
# Local dev only (FES_MCP_AUTH=env): one Sisense credential from the env.
# Ignored in upstream mode — there, every request carries its own credential.
# ---------------------------------------------------------------------------
SISENSE_DOMAIN=https://your-instance.sisense.com
SISENSE_TOKEN=
SISENSE_SSL_VERIFY=true

# ---------------------------------------------------------------------------
# fes-mcp (resource server)
# ---------------------------------------------------------------------------
# upstream = per-request credentials injected by fes-auth as Authorization
#            bearer + X-Sisense-Url headers. Internal network only — no
#            shared secret between the services.
# env      = the SISENSE_* credential above (local development).
# Unset: follows the transport — http ⇒ upstream, stdio ⇒ env.
#FES_MCP_AUTH=

# stdio = a local MCP client launches the process (dev config)
# http  = network server (required for upstream mode)
FES_MCP_TRANSPORT=stdio
FES_MCP_HOST=127.0.0.1
FES_MCP_PORT=8200

# Upstream mode. Optional exact-match allowlist of Sisense origins the
# X-Sisense-Url header may name (unset = accept any — fes-auth
# names the targets). And how long a verified (domain, token) pair is trusted
# before re-checking Sisense — a revoked token becomes a 401 within at most
# this many seconds.
#FES_MCP_ALLOWED_SISENSE_ORIGINS=*.sisense.com,http://10.0.0.5   # exact origins and *.suffix wildcards
#FES_MCP_VERIFY_TTL=300

# ---------------------------------------------------------------------------
# fes-auth (authorization server + proxy)
# ---------------------------------------------------------------------------
# Public HTTPS base URL of fes-auth — OAuth discovery and redirect URLs are
# built from it. Required when hosted behind TLS.
#FES_MCP_PUBLIC_URL=https://your-host.example.com

# The resource server fes-auth proxies tool calls to (compose sets this to
# the internal service address).
#FES_MCP_RS_URL=http://fes-mcp:8200

# ---------------------------------------------------------------------------
# Tool surface (fes-mcp)
# ---------------------------------------------------------------------------
# false = read-only server. true = all tools; mutating tools ask the user for
# approval via MCP elicitation on clients that support it.
FES_MCP_ALLOW_MUTATIONS=false

# Optional override of config/allowlist.txt: comma-separated tool_ids and/or
# module names, e.g. "dashboard,folder.get_all_folders".
#FES_MCP_TOOLS=

# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------
#FES_MCP_REGISTRY_PATH=config/tools.registry.with_examples.json
#FES_MCP_LOG_LEVEL=INFO
#FES_MCP_LOG_DIR=logs                # where fes-mcp.log / fes-auth.log are written
