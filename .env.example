# fes_mcp configuration reference.
# Copy to .env for local development (.env is gitignored; loaded by `fes-mcp`).
# In hosted deployments, set these as real environment variables on the
# container/service instead — no .env file there.

# ---------------------------------------------------------------------------
# Local dev only (FES_MCP_AUTH=none): one shared Sisense credential.
# Ignored in oauth mode — there, every user signs in with their own account.
# ---------------------------------------------------------------------------
SISENSE_DOMAIN=https://your-instance.sisense.com
SISENSE_TOKEN=
SISENSE_SSL_VERIFY=true

# ---------------------------------------------------------------------------
# Server mode
# ---------------------------------------------------------------------------
# none  = local dev, uses the SISENSE_* credential above
# oauth = hosted, per-user browser login (requires http transport + public URL)
FES_MCP_AUTH=none

# stdio = local MCP client launches the process (Claude Desktop dev config)
# http  = network server (required for oauth mode)
FES_MCP_TRANSPORT=stdio
FES_MCP_HOST=127.0.0.1
FES_MCP_PORT=8200

# Public HTTPS base URL of this server — required in oauth mode
# (OAuth redirect URIs are built from it).
#FES_MCP_PUBLIC_URL=https://your-host.example.com

# ---------------------------------------------------------------------------
# Tool surface
# ---------------------------------------------------------------------------
# false = read-only server (68 tools). true = all 110 tools; mutating tools
# ask the user for approval via MCP elicitation on clients that support it.
FES_MCP_ALLOW_MUTATIONS=false

# Optional override of config/allowlist.txt: comma-separated tool_ids and/or
# module names, e.g. "dashboard,folder.get_all_folders".
#FES_MCP_TOOLS=

# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------
#FES_MCP_REGISTRY_PATH=config/tools.registry.with_examples.json
#FES_MCP_LOG_LEVEL=INFO
