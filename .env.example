# --- Sisense tenant (required) ------------------------------------------
# The server is a single-tenant connection: it talks to ONE Sisense instance.
SISENSE_DOMAIN=your-instance.sisense.com
SISENSE_TOKEN=your-sisense-api-token
# Verify TLS certificates when calling Sisense (set false for self-signed certs)
SISENSE_SSL_VERIFY=true

# --- Auth mode for MCP clients -------------------------------------------
# none   : no auth (local dev, stdio or trusted localhost HTTP)
# bearer : static bearer token required on HTTP requests (set FES_MCP_BEARER_TOKEN)
# oauth  : OAuth 2.1 (not yet implemented)
FES_MCP_AUTH=none
# FES_MCP_BEARER_TOKEN=change-me

# --- Tool surface ---------------------------------------------------------
# Comma-separated allowlist of tool_ids and/or module names from the registry.
# A module name (e.g. "dashboard") includes every tool in that module.
# Leave unset to use the curated default in config/allowlist.txt.
# FES_MCP_TOOLS=dashboard,datamodel.get_all_datamodel

# Allow tools that mutate the Sisense instance (default false = read-only surface)
FES_MCP_ALLOW_MUTATIONS=false

# --- Server ---------------------------------------------------------------
# Transport: stdio (Claude Desktop local) or http (streamable HTTP)
FES_MCP_TRANSPORT=stdio
FES_MCP_HOST=127.0.0.1
FES_MCP_PORT=8200

# Path to the generated tool registry (default: config/tools.registry.with_examples.json)
# FES_MCP_REGISTRY_PATH=

# Logging
FES_MCP_LOG_LEVEL=INFO
